# Build
build/

# Binaries
*.dll
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# IDE
.vs/
.vscode/
*.suo
*.user

# OS
Thumbs.db
nul

# Logs
*.log
# But DO track per-run repro evidence under docs/repro/runs/
!docs/repro/runs/**/*.log

# Raw packet captures — too big for git (100+ MB each).
# Keep the analysis docs (README.md, analysis.md, timeline.txt, host.log)
# and the capture.cmd recipe; regenerate the raw files locally if needed.
docs/repro/runs/**/capture.etl
docs/repro/runs/**/capture.pcapng
docs/repro/runs/**/capture.txt
docs/repro/runs/**/capture.utf8.txt

# Dist/Release binaries (source only in git)
dist/*.exe
dist/*.dll
Release/*.exe
Release/*.dll

.claude/
*.zip
third_party/ds3os

# Secrets — NEVER commit private keys
private.key
*.pem

# Server runtime data
*.sqlite
*.time
server/Saved/default/private.key
server/Saved/default/database.sqlite
server/Saved/default/last_activity.time
Release/Server/Saved/default/private.key
Release/Server/Saved/default/database.sqlite
Release/Server/Saved/default/last_activity.time
third_party/ds3os/build/
